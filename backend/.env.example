NODE_ENV=development
PORT=3333

# Configure estes valores localmente. Nunca commite o arquivo .env.
DATABASE_URL="mysql://jm_beauty:change-this-password@localhost:3306/jm_beauty"
MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_DATABASE=jm_beauty
MYSQL_USER=jm_beauty
MYSQL_PASSWORD=change-this-password

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-another-random-secret-at-least-32-characters
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:8081,http://localhost:19006
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=180
AUTH_RATE_LIMIT_MAX=30

# O seed só cria um administrador quando ambos os valores abaixo forem definidos.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
PUSH_ENABLED=false
EXPO_ACCESS_TOKEN=
