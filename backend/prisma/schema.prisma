generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER     @map("user")
  OPERATOR @map("operator")
  ADMIN    @map("admin")
}

enum AppointmentStatus {
  PENDING     @map("pending")
  CONFIRMED   @map("confirmed")
  IN_PROGRESS @map("in_progress")
  COMPLETED   @map("completed")
  CANCELLED   @map("cancelled")
  NO_SHOW     @map("no_show")
}

enum PaymentMethod {
  CASH        @map("cash")
  PIX         @map("pix")
  CREDIT_CARD @map("credit_card")
  DEBIT_CARD  @map("debit_card")
  OTHER       @map("other")
}

enum PaymentStatus {
  PENDING   @map("pending")
  PAID      @map("paid")
  REFUNDED  @map("refunded")
  CANCELLED @map("cancelled")
}

enum CashRegisterStatus {
  OPEN   @map("open")
  CLOSED @map("closed")
  REVIEW @map("review")
}

enum CashTransactionType {
  INCOME  @map("income")
  EXPENSE @map("expense")
}

model User {
  id                  Int             @id @default(autoincrement())
  name                String          @db.VarChar(100)
  email               String          @unique @db.VarChar(191)
  phone               String          @default("") @db.VarChar(30)
  passwordHash        String          @map("password_hash") @db.VarChar(255)
  role                UserRole        @default(USER)
  active              Boolean         @default(true)
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  customer            Customer?
  appointments        Appointment[]
  refreshTokens       RefreshToken[]
  passwordResets      PasswordReset[]
  notifications       Notification[]
  pushDevices         PushDevice[]
  waitlistEntries     WaitlistEntry[]
  auditLogs           AuditLog[]
  cashTransactions    CashTransaction[] @relation("CashTransactionCreator")
  managedUsers        User[]            @relation("UserManager")
  manager             User?              @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  managerId           Int?               @map("manager_id")

  @@index([role, active])
  @@map("users")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  userId    Int      @map("user_id")
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("refresh_tokens")
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  userId    Int      @map("user_id")
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_resets")
}

model Service {
  id               Int               @id @default(autoincrement())
  name             String            @db.VarChar(100)
  description      String            @default("") @db.VarChar(500)
  price            Int
  duration         Int
  buffer           Int               @default(0)
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  appointments     Appointment[]
  skills           ProfessionalSkill[]
  commissionRule   CommissionRule?
  waitlistEntries  WaitlistEntry[]

  @@index([active, name])
  @@map("services")
}

model Professional {
  id          Int                 @id @default(autoincrement())
  name        String              @db.VarChar(100)
  phone       String              @default("") @db.VarChar(30)
  email       String?             @unique @db.VarChar(191)
  specialty   String              @default("") @db.VarChar(150)
  active      Boolean             @default(true)
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  appointments Appointment[]
  skills      ProfessionalSkill[]
  blocks      ScheduleBlock[]
  commissions Commission[]
  waitlistEntries WaitlistEntry[]

  @@index([active, name])
  @@map("professionals")
}

model ProfessionalSkill {
  professionalId Int          @map("professional_id")
  serviceId      Int          @map("service_id")
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service        Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([professionalId, serviceId])
  @@map("professional_skills")
}

model Customer {
  id        Int      @id @default(autoincrement())
  userId    Int?     @unique @map("user_id")
  name      String   @db.VarChar(100)
  phone     String   @default("") @db.VarChar(30)
  email     String?  @db.VarChar(191)
  notes     String   @default("") @db.Text
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  appointments Appointment[]

  @@index([name, phone])
  @@map("customers")
}

model Appointment {
  id             Int               @id @default(autoincrement())
  userId         Int               @map("user_id")
  customerId     Int?              @map("customer_id")
  professionalId Int               @map("professional_id")
  serviceId      Int               @map("service_id")
  startsAt       DateTime          @map("starts_at")
  endsAt         DateTime          @map("ends_at")
  status         AppointmentStatus @default(CONFIRMED)
  price          Int
  serviceName    String            @map("service_name") @db.VarChar(100)
  notes          String            @default("") @db.VarChar(500)
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  user           User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  customer       Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  professional   Professional      @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  service        Service           @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  items          AppointmentItem[]
  adjustment     OrderAdjustment?
  payments       Payment[]
  commission     Commission?

  @@index([professionalId, startsAt, endsAt, status])
  @@index([userId, startsAt])
  @@index([customerId, startsAt])
  @@map("appointments")
}

model BusinessHour {
  id          Int      @id @default(autoincrement())
  dayOfWeek   Int      @map("day_of_week")
  openingTime String   @map("opening_time") @db.Char(5)
  closingTime String   @map("closing_time") @db.Char(5)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([dayOfWeek, openingTime, closingTime])
  @@map("business_hours")
}

model ScheduleBlock {
  id             Int          @id @default(autoincrement())
  professionalId Int?         @map("professional_id")
  startsAt       DateTime     @map("starts_at")
  endsAt         DateTime     @map("ends_at")
  reason         String       @default("") @db.VarChar(200)
  professional   Professional? @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId, startsAt, endsAt])
  @@map("schedule_blocks")
}

model Payment {
  id            Int           @id @default(autoincrement())
  appointmentId Int           @map("appointment_id")
  amount        Int
  method        PaymentMethod
  status        PaymentStatus @default(PAID)
  paidAt        DateTime      @default(now()) @map("paid_at")
  requestKey    String        @unique @map("request_key") @db.VarChar(100)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  appointment   Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  refunds       Refund[]

  @@index([appointmentId, paidAt])
  @@map("payments")
}

model Refund {
  id         Int      @id @default(autoincrement())
  paymentId  Int      @map("payment_id")
  amount     Int
  reason     String   @db.VarChar(200)
  requestKey String   @unique @map("request_key") @db.VarChar(100)
  createdAt  DateTime @default(now()) @map("created_at")
  payment    Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId, createdAt])
  @@map("refunds")
}

model Product {
  id        Int               @id @default(autoincrement())
  name      String            @db.VarChar(100)
  price     Int
  stock     Int               @default(0)
  minimum   Int               @default(3)
  active    Boolean           @default(true)
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  items     AppointmentItem[]

  @@index([active, name])
  @@map("products")
}

model AppointmentItem {
  id            Int          @id @default(autoincrement())
  appointmentId Int          @map("appointment_id")
  kind          String       @db.VarChar(20)
  name          String       @db.VarChar(100)
  quantity      Int          @default(1)
  unitPrice     Int          @map("unit_price")
  productId     Int?         @map("product_id")
  commission    Int          @default(0)
  appointment   Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  product       Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([appointmentId, kind])
  @@map("appointment_items")
}

model OrderAdjustment {
  appointmentId Int         @id @map("appointment_id")
  discount      Int         @default(0)
  extra         Int         @default(0)
  reason        String      @default("") @db.VarChar(200)
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@map("order_adjustments")
}

model CommissionRule {
  serviceId Int     @id @map("service_id")
  percent   Int     @default(0)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("commission_rules")
}

model Commission {
  appointmentId  Int          @id @map("appointment_id")
  professionalId Int          @map("professional_id")
  amount         Int
  paidAt         DateTime?    @map("paid_at")
  expenseId      Int?         @map("expense_id")
  appointment    Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Restrict)

  @@map("commissions")
}

model Expense {
  id          Int      @id @default(autoincrement())
  description String   @db.VarChar(200)
  amount      Int
  method      PaymentMethod
  date        DateTime @db.Date
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([date, method])
  @@map("expenses")
}

model CashRegister {
  id             Int                 @id @default(autoincrement())
  businessDate   DateTime            @unique @map("business_date") @db.Date
  openedAt       DateTime            @default(now()) @map("opened_at")
  closedAt       DateTime?           @map("closed_at")
  openingBalance Int                 @default(0) @map("opening_balance")
  expectedBalance Int?               @map("expected_balance")
  countedBalance Int?                @map("counted_balance")
  closingBalance Int?                @map("closing_balance")
  status         CashRegisterStatus  @default(OPEN)
  transactions   CashTransaction[]
  createdAt      DateTime            @default(now()) @map("created_at")

  @@index([status, openedAt])
  @@map("cash_registers")
}

model CashTransaction {
  id              Int                 @id @default(autoincrement())
  cashRegisterId  Int                 @map("cash_register_id")
  type            CashTransactionType
  description     String              @db.VarChar(200)
  amount          Int
  paymentMethod   PaymentMethod?      @map("payment_method")
  createdBy       Int                 @map("created_by")
  createdAt       DateTime            @default(now()) @map("created_at")
  cashRegister    CashRegister        @relation(fields: [cashRegisterId], references: [id], onDelete: Cascade)
  creator         User                @relation("CashTransactionCreator", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([cashRegisterId, createdAt])
  @@map("cash_transactions")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  title     String   @db.VarChar(250)
  readAt    DateTime? @map("read_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushQueue PushQueue[]

  @@index([userId, createdAt])
  @@map("notifications")
}

model PushDevice {
  id        Int      @id @default(autoincrement())
  token     String   @unique @db.VarChar(255)
  userId    Int      @map("user_id")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  queue     PushQueue[]

  @@index([userId, enabled])
  @@map("push_devices")
}

model WaitlistEntry {
  id             Int      @id @default(autoincrement())
  userId         Int      @map("user_id")
  serviceId      Int      @map("service_id")
  professionalId Int      @map("professional_id")
  date           DateTime @db.Date
  status         String   @default("waiting") @db.VarChar(30)
  createdAt      DateTime @default(now()) @map("created_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  service        Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([date, professionalId, serviceId])
  @@map("waitlist_entries")
}

model PushQueue {
  id             Int          @id @default(autoincrement())
  notificationId Int          @map("notification_id")
  token          String       @db.VarChar(255)
  status         String       @default("pending") @db.VarChar(30)
  attempts       Int          @default(0)
  nextAttempt    DateTime?    @map("next_attempt")
  ticketId       String?      @map("ticket_id") @db.VarChar(100)
  sentAt         DateTime?    @map("sent_at")
  error          String?      @db.Text
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  device         PushDevice   @relation(fields: [token], references: [token], onDelete: Cascade)

  @@unique([notificationId, token])
  @@index([status, nextAttempt, attempts])
  @@map("push_queue")
}

model JobKey {
  key       String   @id @db.VarChar(191)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("job_keys")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  action    String   @db.VarChar(100)
  entityId  Int?     @map("entity_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt, action])
  @@map("audit_logs")
}

model MonthlyReport {
  month     String   @id @db.Char(7)
  data      Json
  createdAt DateTime @default(now()) @map("created_at")

  @@map("monthly_reports")
}

model SalonSetting {
  id                     Int      @id @default(1)
  salonName              String   @default("JM Beauty") @map("salon_name") @db.VarChar(120)
  phone                  String   @default("") @db.VarChar(30)
  address                String   @default("") @db.VarChar(255)
  openingTime            String   @default("09:00") @map("opening_time") @db.Char(5)
  closingTime            String   @default("19:00") @map("closing_time") @db.Char(5)
  openHour               Int      @default(9) @map("open_hour")
  closeHour              Int      @default(19) @map("close_hour")
  closeTime              String   @default("19:00") @map("close_time") @db.Char(5)
  days                   Json     @default("[1,2,3,4,5,6]")
  cancelHours            Int      @default(24) @map("cancel_hours")
  bookingAdvanceHours    Int      @default(1) @map("booking_advance_hours")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@map("salon_settings")
}
